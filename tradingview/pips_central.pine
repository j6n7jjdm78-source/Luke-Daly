//@version=5
// Pips Central - 15m/1h trend + support/resistance rejection signals.
// Same logic as the Python scanner. Use on a 15 minute chart.
// Sends alerts through a TradingView webhook straight to Telegram (see tradingview/README.md).
indicator("Pips Central - Trend + S/R Signals", overlay=true, max_labels_count=200, max_lines_count=200)

pivLen     = input.int(5, "Pivot length", minval=2)
tolMult    = input.float(0.6, "Zone tolerance (x 1h ATR)", minval=0.1, step=0.1)
minTouches = input.int(3, "Min touches for a level", minval=2)
minRR      = input.float(1.5, "Min reward:risk", minval=1.0, step=0.1)
slPad      = input.float(0.3, "Stop padding (x 15m ATR)", minval=0.0, step=0.1)
chatId     = input.string("", "Telegram chat id (e.g. -100123...)")
label_     = input.string("", "Name in alerts (blank = chart symbol)")

// ---------- trend ----------
f_trend() =>
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    up = e20 > e50 and close > e50 and e50 > e50[5]
    dn = e20 < e50 and close < e50 and e50 < e50[5]
    up ? 1 : dn ? -1 : 0

t15   = f_trend()
t1h   = request.security(syminfo.tickerid, "60", f_trend()[1], lookahead=barmerge.lookahead_on)
atr1h = request.security(syminfo.tickerid, "60", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
atr15 = ta.atr(14)

// ---------- pivot prices (15m pivots + 1h pivots counted double) ----------
var pts = array.new_float()
ph  = ta.pivothigh(high, pivLen, pivLen)
pl  = ta.pivotlow(low, pivLen, pivLen)
ph1 = request.security(syminfo.tickerid, "60", ta.pivothigh(high, 5, 5), lookahead=barmerge.lookahead_off)
pl1 = request.security(syminfo.tickerid, "60", ta.pivotlow(low, 5, 5), lookahead=barmerge.lookahead_off)

if not na(ph)
    array.push(pts, ph)
if not na(pl)
    array.push(pts, pl)
if not na(ph1) and (na(ph1[1]) or ph1 != ph1[1])
    array.push(pts, ph1)
    array.push(pts, ph1)
if not na(pl1) and (na(pl1[1]) or pl1 != pl1[1])
    array.push(pts, pl1)
    array.push(pts, pl1)
while array.size(pts) > 200
    array.shift(pts)

// nearest cluster of pivot prices below (above=false) or above (above=true) a price
f_zone(price, tol, minT, above) =>
    float c = na
    float zl = na
    float zh = na
    int cn = 0
    n = array.size(pts)
    if n > 0
        for i = 0 to n - 1
            p = array.get(pts, i)
            ok = above ? p > price : p < price
            if ok
                int cnt = 0
                float lo_ = p
                float hi_ = p
                for j = 0 to n - 1
                    q = array.get(pts, j)
                    if math.abs(q - p) <= tol
                        cnt += 1
                        lo_ := math.min(lo_, q)
                        hi_ := math.max(hi_, q)
                if cnt >= minT and (na(c) or (above ? p < c : p > c))
                    c := p
                    zl := lo_
                    zh := hi_
                    cn := cnt
    [c, zl, zh, cn]

// ---------- signal ----------
rng       = math.max(high - low, syminfo.mintick)
lowWick   = (math.min(open, close) - low) / rng
upWick    = (high - math.max(open, close)) / rng
tol       = tolMult * atr1h
pad       = 0.15 * tol
name      = label_ == "" ? syminfo.ticker : label_

f_fire(side, entry, sl, tp, touches, zl, zh) =>
    rr = math.abs(tp - entry) / math.abs(entry - sl)
    arrow = side == "BUY" ? "🟢" : "🔴"
    txt = arrow + " " + name + " " + side + "\\nEntry: " + str.tostring(entry, format.mintick) + "\\nSL: " + str.tostring(sl, format.mintick) + "\\nTP: " + str.tostring(tp, format.mintick) + "\\nRR " + str.tostring(rr, "#.0") + " | level touches " + str.tostring(touches) + "\\nNot financial advice."
    msg = '{"chat_id":"' + chatId + '","text":"' + txt + '"}'
    alert(msg, alert.freq_once_per_bar_close)
    label.new(bar_index, side == "BUY" ? low : high, side, style = side == "BUY" ? label.style_label_up : label.style_label_down, color = side == "BUY" ? color.green : color.red, textcolor = color.white)
    line.new(bar_index, sl, bar_index + 20, sl, color = color.red, style = line.style_dashed)
    line.new(bar_index, tp, bar_index + 20, tp, color = color.green, style = line.style_dashed)

if barstate.isconfirmed and not na(atr1h) and not na(atr15)
    if t15 == 1 and t1h == 1 and close > open and lowWick >= 0.25
        [c, zl, zh, cn] = f_zone(close, tol, minTouches, false)
        if not na(c) and low <= zh + pad and close > zh
            sl = zl - slPad * atr15
            risk = close - sl
            if risk > 0
                [rc, rzl, rzh, rcn] = f_zone(close + risk, tol, 2, true)
                tp = na(rzl) ? close + 2 * risk : rzl
                if (tp - close) / risk >= minRR
                    f_fire("BUY", close, sl, tp, cn, zl, zh)
    if t15 == -1 and t1h == -1 and close < open and upWick >= 0.25
        [c2, zl2, zh2, cn2] = f_zone(close, tol, minTouches, true)
        if not na(c2) and high >= zl2 - pad and close < zl2
            sl2 = zh2 + slPad * atr15
            risk2 = sl2 - close
            if risk2 > 0
                [sc, szl, szh, scn] = f_zone(close - risk2, tol, 2, false)
                tp2 = na(szh) ? close - 2 * risk2 : szh
                if (close - tp2) / risk2 >= minRR
                    f_fire("SELL", close, sl2, tp2, cn2, zl2, zh2)

// show the trend state so you can see why nothing fires
bgcolor(t15 == 1 and t1h == 1 ? color.new(color.green, 92) : t15 == -1 and t1h == -1 ? color.new(color.red, 92) : na)
